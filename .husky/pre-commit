#!/usr/bin/env sh
cd "$(git rev-parse --show-toplevel)" || exit 1
echo "🔍 Running pre-commit checks..."
npx lint-staged || exit 1

if [ "${OKF_SKIP:-}" = "1" ]; then
  exit 0
fi

echo "Refreshing OKF bundle…"
bun scripts/okf/cli.ts enrich --from-index --stage || exit 1
# oo-verify:begin
# OpenOrchestrate verify (composed into husky; keep these markers)
if [ -f scripts/verify.sh ]; then
  bash scripts/verify.sh pre-commit || exit 1
fi
# oo-verify:end
